{
    "name": "rtcamp/wp-tooling-monorepo",
    "description": "rtCamp WordPress tooling monorepo — development root for the Composer packages under composer-packages/*.",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require": {
        "automattic/vipwpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php": ">=8.4.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "slevomat/coding-standard": "^8.12",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.10",
        "symplify/monorepo-builder": "^12.7"
    },
    "replace": {
        "rtcamp/wp-phpcs": "self.version",
        "rtcamp/wp-phpstan": "self.version"
    }
}
