{
    "name": "rtcamp/wp-tooling-monorepo",
    "description": "rtCamp WordPress tooling monorepo — development root for the Composer packages under composer-packages/*.",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require": {
      "php": ">=8.4",
      "automattic/vipwpcs": "^3.0",
      "phpcompatibility/phpcompatibility-wp": "^3.0.0-alpha",
      "slevomat/coding-standard": "^8.12"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.10",
        "symplify/monorepo-builder": "^12.7"
    },
    "replace": {
        "rtcamp/wp-phpcs": "self.version",
        "rtcamp/wp-phpstan": "self.version"
    }
}
