    "@wordpress/eslint-plugin": "^25.1.0",
    "@wordpress/stylelint-config": "^23.37.0",
    "eslint": "^10.0.0",
    "eslint-plugin-jest": "^29.0.0",
    "stylelint": "^16.8.2",
    "stylelint-scss": "^6.4.0",
    "@tailwindcss/postcss": "^4.3.0",
    "tailwindcss": "^4.3.0"
