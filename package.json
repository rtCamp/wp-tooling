    "./scaffolds": "./src/scaffolds/index.js",
    "./release": "./src/release/index.js",
    "./hooks": "./src/hooks/index.js",
    "./ci": "./src/ci/index.js",
    "./version-monitor": "./src/version-monitor/index.js",
    "./eslint-config": "./src/lint/eslint.js",
    "./stylelint-config": "./src/lint/stylelint.js",
    "./tailwind-config": "./src/tailwind/index.js",
