{
  "name": "@rtcamp/wp-tooling",
  "description": "Shared tooling for rtCamp WordPress plugin scaffolding — TTY UI, scaffold registry, release scripts, git hooks, CI helpers, version monitor.",
  "version": "0.1.0",
  "author": "rtCamp",
  "// overrides": "Forces minimatch off the vulnerable 9.0.0-9.0.6 range (3 high-severity ReDoS CVEs reaching us via the @typescript-eslint/typescript-estree chain that @wordpress/eslint-plugin v22 pulls in). Remove this block once we can bump @wordpress/eslint-plugin to v25, which requires ESLint 9. The bump is gated on @wordpress/scripts officially supporting ESLint 9 (we follow its pin per CLAUDE.md).",
  "bin": {
    "wp-tooling": "./bin/wp-tooling.js"
  },
  "bugs": {
    "url": "https://github.com/rtCamp/wp-tooling/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@wordpress/eslint-plugin": "^22.0.0",
    "eslint": "8.57.1",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./ui": "./src/ui/index.js",
    "./scaffolds": "./src/scaffolds/index.js",
    "./release": "./src/release/index.js",
    "./hooks": "./src/hooks/index.js",
    "./ci": "./src/ci/index.js",
    "./version-monitor": "./src/version-monitor/index.js",
    "./eslint-config": "./src/lint/eslint.js",
    "./stylelint-config": "./src/lint/stylelint.js",
    "./tailwind-config": "./src/tailwind/index.js",
    "./tailwind-config/postcss": "./src/tailwind/postcss.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/rtCamp/wp-tooling#readme",
  "keywords": [
    "cli",
    "rtcamp",
    "scaffolding",
    "tooling",
    "tty",
    "wordpress"
  ],
  "license": "GPL-2.0-or-later",
  "overrides": {
    "minimatch": "^9.0.7"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/postcss": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtCamp/wp-tooling.git"
  },
  "scripts": {
    "check": "npm run lint && npm test",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  }
}
