#!/usr/bin/env sh
# Conventional Commits validator. Bypasses for merge commits, revert commits,
# fixup/squash commits, and the initial commit.
msg_file="$1"
first_line="$(head -n 1 "$msg_file")"

# Allow merges, reverts, fixups, squashes.
case "$first_line" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

# Pattern: type(scope)?!?: subject
pattern='^(feat|fix|chore|docs|refactor|test|perf|build|ci|style)(\([a-z0-9-]+\))?!?: .+'
if printf '%s' "$first_line" | grep -Eq "$pattern"; then
    exit 0
fi

echo "✗ Commit message must follow Conventional Commits."
echo "  Got:      $first_line"
echo "  Examples: feat(utilities): add Logger"
echo "            fix(release): handle empty CHANGELOG"
echo "            docs: update README"
exit 1
