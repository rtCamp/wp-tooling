{
  "name": "@rtcamp/eslint-config",
  "version": "2.0.0",
  "description": "rtCamp shareable ESLint flat config for WordPress projects — extends @wordpress/eslint-plugin.",
  "license": "GPL-2.0-or-later",
  "author": "rtCamp",
  "homepage": "https://github.com/rtCamp/wp-tooling/tree/main/node-packages/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtCamp/wp-tooling.git",
    "directory": "node-packages/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/rtCamp/wp-tooling/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.19"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./jest": "./jest.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "base.js",
    "jest.js",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "rtcamp",
    "wordpress"
  ],
  "scripts": {
    "lint": "eslint index.js base.js jest.js tests",
    "lint:fix": "eslint index.js base.js jest.js tests --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm test"
  },
  "peerDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@wordpress/eslint-plugin": "^27.0.0 || ^28.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-jest": "^29.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-jest": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint-plugin-jest": "^29.0.0",
    "jest": "^29.7.0"
  }
}
