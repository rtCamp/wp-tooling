name: CI / Lint (CSS)

# Scaffolded by @rtcamp/wp-tooling.
# Calls the reusable ci-lint-css.yml from rtCamp/wp-shared-workflows.
#
# Source: https://github.com/rtCamp/wp-shared-workflows/blob/{{wsw_ref}}/.github/workflows/ci-lint-css.yml

on:
  pull_request:
  push:
    branches:
      - main
      - develop
      - "release/*"

permissions:
  contents: read

jobs:
  lint-css:
    uses: rtCamp/wp-shared-workflows/.github/workflows/ci-lint-css.yml@{{wsw_ref}}{{#node_version}}
    with:
      node-version: "{{node_version}}"{{/node_version}}
