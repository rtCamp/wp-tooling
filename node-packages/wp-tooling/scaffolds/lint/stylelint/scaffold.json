{
	"slug": "stylelint",
	"category": "lint",
	"name": "Stylelint setup",
	"description": "Installs Stylelint with rtCamp's shared config (extends `@rtcamp/stylelint-config`) and adds lint:css scripts.",
	"source": "template",
	"files": [
		{
			"src": "templates/.stylelintrc.js.mustache",
			"dest": ".stylelintrc.js"
		}
	],
	"npm_dev_dependencies": {
		"stylelint": "^16.8.2",
		"@wordpress/stylelint-config": "^23.37.0",
		"stylelint-scss": "^6.4.0",
		"@rtcamp/stylelint-config": "^0.1.0"
	},
	"scripts": {
		"npm": {
			"lint:css": "stylelint 'assets/**/*.{css,scss}'",
			"lint:css:fix": "stylelint 'assets/**/*.{css,scss}' --fix"
		}
	}
}
