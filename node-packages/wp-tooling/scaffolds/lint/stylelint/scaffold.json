{
	"slug": "stylelint",
	"category": "lint",
	"name": "Stylelint setup",
	"description": "Installs Stylelint with rtCamp's shared config (extends `@rtcamp/wp-tooling/stylelint-config`) and adds lint:css scripts.",
	"source": "template",
	"files": [
		{
			"src": "templates/.stylelintrc.js.mustache",
			"dest": ".stylelintrc.js"
		}
	],
	"npm_dev_dependencies": {
		"stylelint": "^16.0.0",
		"@wordpress/stylelint-config": "^23.0.0",
		"@rtcamp/wp-tooling": "^1.0.0"
	},
	"scripts": {
		"npm": {
			"lint:css": "stylelint 'assets/**/*.{css,scss}'",
			"lint:css:fix": "stylelint 'assets/**/*.{css,scss}' --fix"
		}
	}
}
