# https://phpstan.org/config-reference
# Scaffolded by @rtcamp/wp-tooling.

includes:
    - vendor/rtcamp/wp-phpstan/phpstan.neon.dist

parameters:
    # Your own PHP. A path that doesn't exist stops PHPStan.
    paths: [{{paths}}]
    # Only matters if `paths` includes `.`.
    excludePaths:
        - vendor (?)
        - node_modules (?)
