{
	"slug": "eslint",
	"category": "lint",
	"name": "ESLint setup",
	"description": "Installs ESLint with rtCamp's shared config (extends `@rtcamp/eslint-config/jest`, Jest test rules) and adds lint:js scripts.",
	"source": "template",
	"files": [
		{
			"src": "templates/eslint.config.js.mustache",
			"dest": "eslint.config.js"
		}
	],
	"npm_dev_dependencies": {
		"eslint": "^10.0.0",
		"@wordpress/eslint-plugin": "^28.0.0",
		"@rtcamp/eslint-config": "^2.0.0",
		"eslint-plugin-jest": "^29.0.0"
	},
	"scripts": {
		"npm": {
			"lint:js": "eslint src assets",
			"lint:js:fix": "eslint src assets --fix"
		}
	}
}
