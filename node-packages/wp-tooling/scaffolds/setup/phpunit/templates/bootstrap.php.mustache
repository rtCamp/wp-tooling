<?php
/**
 * PHPUnit bootstrap: loads Composer autoloader and optionally the
 * WordPress test suite when WP_TESTS_DIR is set.
 *
 * @package {{tests_namespace}}
 */

declare( strict_types = 1 );

require_once dirname( __DIR__ ) . '/vendor/autoload.php';

// Integration tests: load the WordPress test library.
$wp_tests_dir = getenv( 'WP_TESTS_DIR' );
if ( $wp_tests_dir ) {
	require_once $wp_tests_dir . '/includes/functions.php';

	tests_add_filter(
		'muplugins_loaded',
		static function () {
			// Require the plugin under test here, e.g. dirname( __DIR__ ) . '/plugin-name.php'.
		}
	);

	require $wp_tests_dir . '/includes/bootstrap.php';
}
