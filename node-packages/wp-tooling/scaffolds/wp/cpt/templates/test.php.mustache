 */
final class {{class}}Test extends WP_UnitTestCase {

	/**
	 * The post type key is the one the class registers under.
	 */
	public function test_slug_matches_manifest(): void {
		$this->assertSame( '{{slug}}', {{class}}::get_slug() );
	}

	/**
	 * Registration is deferred to init, where register_post_type() is available.
	 */
	public function test_register_hooks_attaches_to_init(): void {
		$instance = new {{class}}();
		$instance->register_hooks();
		$this->assertNotFalse( has_action( 'init', [ $instance, 'register' ] ) );
	}

	/**
	 * Registration actually lands in core's post type registry.
	 */
	public function test_post_type_is_registered_after_init(): void {
		( new {{class}}() )->register();
		$this->assertTrue( post_type_exists( '{{slug}}' ) );
	}
}
