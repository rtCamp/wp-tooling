namespace {{tests_namespace}};

use {{namespace}}\{{class}};
use WP_UnitTestCase;

/**
 * Class {{class}}Test
 *
 * @covers \{{namespace}}\{{class}}
 */
final class {{class}}Test extends WP_UnitTestCase {

	/**
	 * The page slug is the one the settings page is registered under.
	 */
	public function test_slug_matches_manifest(): void {
		$this->assertSame( '{{slug}}', {{class}}::get_slug() );
	}

	/**
	 * The settings map is an array the registration loop can walk.
	 */
	public function test_get_settings_returns_array(): void {
		$this->assertIsArray( ( new {{class}}() )->get_settings() );
	}

	/**
	 * The option reaches core's settings registry, so the Settings API renders and sanitises it.
	 *
	 * Calls the registration callback directly. Firing do_action( 'admin_init' )
	 * would re-run core's own admin_init listeners, which send headers the test
	 * harness has already flushed.
	 */
	public function test_sample_option_is_registered(): void {
		( new {{class}}() )->register_settings();
		$this->assertArrayHasKey( '{{option_name}}', get_registered_settings() );
	}
}
