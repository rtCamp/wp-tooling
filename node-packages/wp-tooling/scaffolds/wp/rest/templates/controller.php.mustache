declare( strict_types = 1 );

namespace {{namespace}};

use WP_REST_Response;
use rtCamp\WPFramework\Contracts\Abstracts\AbstractRESTController;

/**
 * Registers REST routes for the {{name}} resource.
 */
class {{class}}Controller extends AbstractRESTController {

	/**
	 * REST route namespace (URL prefix before the version).
	 *
	 * @var string
	 */
	protected $namespace = '{{rest_namespace}}';

	/**
	 * REST API version segment.
	 *
	 * @var string
	 */
	protected string $version = '{{rest_version}}';

	/**
	 * The route segment after the namespace and version, e.g. 'images'.
	 *
	 * @var string
	 */
	protected $rest_base = '{{name}}';

	/**
	 * Register REST routes. Called by the framework on rest_api_init.
	 */
	public function register_routes(): void {
		register_rest_route(
			"{$this->namespace}/v{$this->version}",
			'/' . $this->rest_base,
			[
				[
					'methods'             => 'GET',
					'callback'            => [ $this, 'get_items' ],
					'permission_callback' => [ $this, 'get_items_permissions_check' ],
				],
			]
		);
	}

	/**
	 * Return the collection of items.
	 *
	 * WP_REST_Controller declares $request untyped, so this signature cannot
	 * narrow it to WP_REST_Request -- PHP rejects that as incompatible and
	 * fatals when the class loads. `mixed` matches the parent; the annotation
	 * has to match the native hint, so the real type is stated in prose.
	 *
	 * @param mixed $request The REST request, always a WP_REST_Request at runtime.
	 */
	public function get_items( mixed $request ): WP_REST_Response {
		// Replace with your collection response.
		return new WP_REST_Response( [], 200 );
	}

	/**
	 * Permission check for the collection endpoint.
	 *
	 * Typed `mixed` for the same reason as get_items(). The explicit @return
	 * documents this override's own contract: the inherited one is `true|WP_Error`,
	 * which a plain bool does not satisfy.
	 *
	 * @param mixed $request The REST request, always a WP_REST_Request at runtime.
	 * @return bool True when the current user may read the collection.
	 */
	public function get_items_permissions_check( mixed $request ): bool {
		return current_user_can( 'read' );
	}
}
