/**
 * {{vendor}}/{{slug}} block editor view.
 *
 * The front end is server-rendered by render.php and driven by view.js, so the
 * editor only needs a static preview.
 *
 * Scaffolded by @rtcamp/wp-tooling.
 */
import { useBlockProps } from '@wordpress/block-editor';
import { __ } from '@wordpress/i18n';

export default function Edit() {
	const blockProps = useBlockProps();
	return (
		<div { ...blockProps }>
			<p>{ __( '{{title}}', '{{vendor}}-{{slug}}' ) }</p>
		</div>
	);
}
