{
  "name": "@rtcamp/wp-tooling",
  "description": "Shared tooling for rtCamp WordPress plugin scaffolding — TTY UI, scaffold registry, release scripts, git hooks, CI helpers, version monitor.",
  "version": "0.1.0",
  "author": "rtCamp",
  "bin": {
    "wp-tooling": "./bin/wp-tooling.js"
  },
  "bugs": {
    "url": "https://github.com/rtCamp/wp-tooling/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@rtcamp/eslint-config": "^0.1.0",
    "eslint-plugin-n": "^18.0.1",
    "globals": "^17.6.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./ui": "./src/ui/index.js",
    "./init": "./src/init/index.js",
    "./scaffolds": "./src/scaffolds/index.js",
    "./features": "./src/scaffolds/features.js",
    "./release": "./src/release/index.js",
    "./hooks": "./src/hooks/index.js",
    "./ci": "./src/ci/index.js",
    "./perf": "./src/perf/index.js",
    "./version-monitor": "./src/version-monitor/index.js"
  },
    "files": [
        "bin",
        "src",
        "scaffolds",
        "docs",
        "README.md"
    ],
  "homepage": "https://github.com/rtCamp/wp-tooling#readme",
  "keywords": [
    "cli",
    "rtcamp",
    "scaffolding",
    "tooling",
    "tty",
    "wordpress"
  ],
  "license": "GPL-2.0-or-later",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtCamp/wp-tooling.git"
  },
  "scripts": {
    "check": "npm run lint && npm test",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  }
}
