{
  "name": "@rtcamp/stylelint-config",
  "version": "0.1.0",
  "description": "rtCamp shareable Stylelint config for WordPress projects — extends @wordpress/stylelint-config (+ scss).",
  "license": "GPL-2.0-or-later",
  "author": "rtCamp",
  "homepage": "https://github.com/rtCamp/wp-tooling/tree/main/node-packages/stylelint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtCamp/wp-tooling.git",
    "directory": "node-packages/stylelint-config"
  },
  "bugs": {
    "url": "https://github.com/rtCamp/wp-tooling/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "README.md"
  ],
  "keywords": [
    "stylelint",
    "stylelint-config",
    "rtcamp",
    "wordpress",
    "scss"
  ],
  "scripts": {
    "lint": "eslint index.js tests",
    "lint:fix": "eslint index.js tests --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm test"
  },
  "peerDependencies": {
    "@wordpress/stylelint-config": "^23.37.0",
    "stylelint": "^16.8.2",
    "stylelint-scss": "^6.4.0"
  },
  "devDependencies": {
    "@rtcamp/eslint-config": "^0.1.0",
    "jest": "^29.7.0"
  }
}
