{
  "name": "@rtcamp/tailwind-config",
  "version": "0.1.0",
  "description": "rtCamp shareable Tailwind CSS v4 PostCSS config + theme.json→Tailwind webpack plugin for WordPress projects.",
  "license": "GPL-2.0-or-later",
  "author": "rtCamp",
  "homepage": "https://github.com/rtCamp/wp-tooling/tree/main/node-packages/tailwind-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtCamp/wp-tooling.git",
    "directory": "node-packages/tailwind-config"
  },
  "bugs": {
    "url": "https://github.com/rtCamp/wp-tooling/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./postcss": "./postcss.js"
  },
  "files": [
    "index.js",
    "postcss.js",
    "GenerateTailwindThemePlugin.js",
    "README.md"
  ],
  "keywords": [
    "tailwindcss",
    "tailwind",
    "postcss",
    "rtcamp",
    "wordpress"
  ],
  "scripts": {
    "lint": "eslint index.js postcss.js GenerateTailwindThemePlugin.js tests",
    "lint:fix": "eslint index.js postcss.js GenerateTailwindThemePlugin.js tests --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm test"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@rtcamp/eslint-config": "^0.1.0",
    "jest": "^29.7.0"
  }
}
