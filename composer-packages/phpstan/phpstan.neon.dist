# rtCamp shared PHPStan baseline for WordPress projects.
#
# Relative path on purpose: it resolves to the sibling vendor/szepeviktor install
# (this file lives at vendor/rtcamp/wp-phpstan/), so a consumer includes only this
# one file. Don't also enable phpstan/extension-installer for szepeviktor, or the
# extension loads twice and PHPStan fails on the duplicate services.
includes:
    - ../../szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    # WordPress doc-blocks are unreliable; don't treat their types as certain.
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    # Flag wrong-case calls to functions/methods (PHP is case-insensitive here,
    # so these slip through at runtime) and @var tags whose declared type is
    # provably wrong. Orthogonal to treatPhpDocTypesAsCertain.
    checkFunctionNameCase: true
    reportWrongPhpDocTypeInVarTag: true
    ignoreErrors: []
