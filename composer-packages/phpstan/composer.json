{
    "name": "rtcamp/wp-phpstan",
    "description": "rtCamp PHPStan configuration and baseline for WordPress projects.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "phpstan",
        "static analysis",
        "wordpress",
        "rtcamp"
    ],
    "homepage": "https://github.com/rtCamp/wp-tooling/tree/main/composer-packages/phpstan",
    "authors": [
        {
            "name": "rtCamp",
            "homepage": "https://rtcamp.com"
        }
    ],
    "support": {
        "issues": "https://github.com/rtCamp/wp-tooling/issues",
        "source": "https://github.com/rtCamp/wp-tooling/tree/main/composer-packages/phpstan"
    },
    "require": {
        "php": ">=8.2",
        "phpstan/phpstan": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "rtCamp\\WPPhpstan\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
