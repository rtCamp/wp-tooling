<?xml version="1.0"?>
<ruleset
	name="My Project Coding Standards"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd"
>
	<description>Sniffs for My Project — extends the shared rtCamp WordPress standard.</description>

	<!-- ==========================================================
	     What to scan. List the project's PHP entry points and folders.
	     ========================================================== -->
	<file>./includes/</file>
	<file>./tests/</file>
	<file>./access-functions.php</file>
	<file>./activation.php</file>
	<file>./deactivation.php</file>
	<file>./my-plugin.php</file>

	<!-- These are excluded from the above paths.-->
	<exclude-pattern>**/build/**</exclude-pattern>
	<exclude-pattern>**/node_modules/**</exclude-pattern>
	<exclude-pattern>**/vendor/**</exclude-pattern>
	<exclude-pattern>**/tests/_output/**</exclude-pattern>

	<!-- ==========================================================
	     How to scan (so these need not be passed on the CLI).
	     Usage instructions: https://github.com/PHPCSStandards/PHP_CodeSniffer/wiki/Usage
	     Annotated ruleset: https://github.com/PHPCSStandards/PHP_CodeSniffer/wiki/Annotated-ruleset.xml
	     ========================================================== -->
	<!-- Show sniff codes and progress. -->
	<arg value="sp" />
	<!-- Strip file paths down to the relevant bit. -->
	<arg name="basepath" value="./" />
	<!-- Colour the report. -->
	<arg name="colors" />
	<!-- Only lint PHP files. -->
	<arg name="extensions" value="php" />

	<!-- Cache results for faster re-runs. -->
	<arg name="cache" value="tests/_output/cache.json" />
	<!-- Run files in parallel. -->
	<arg name="parallel" value="20" />
	<!-- Set severity to 1 to see everything that isn't turned off. -->
	<arg name="severity" value="1" />


	<!-- ==========================================================
	     Project constraints — set these to match your project.
	     https://github.com/WordPress-Coding-Standards/WordPress-Coding-Standards/wiki/Customizable-sniff-properties
	     ========================================================== -->

	<!-- Minimum PHP Version-->
	<config name="testVersion" value="8.2-" />

	<!-- Minimum WordPress Version -->
	<config name="minimum_wp_version" value="6.9" />


	<!-- ==========================================================
	     The shared rtCamp WordPress standard.

	     rtCampWP        — full strict (recommended for new / public projects).
	     rtCampWP-Basic  — WPCS + VIP + Docs + PHP compatibility, no strict typing
	                       (recommended when adopting on an existing codebase).
	     ========================================================== -->
	<rule ref="rtCampWP">
		<!-- Add any ruleset exclusions here, e.g.:
		<exclude name="SlevomatCodingStandard.TypeHints.DeclareStrictTypes" />
		-->
	</rule>

	<!-- Then, add your additional rulesets or rules. E.g:

	<rule ref="SlevomatCodingStandard.ControlStructures.EarlyExit" />
	-->

	<!--
		File naming. Pick the block that matches your project:
		- Themes: enforce the theme file hierarchy.
	-->
	<!--
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true" />
		</properties>
	</rule>
	-->
	<!-- PSR-4 autoloaded plugins (PascalCase filenames): disable the rule. -->
	<!--
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>
	-->

	<!-- Relax noisy rules in test files (optional). -->
	<rule ref="Generic.Files.OneObjectStructurePerFile.MultipleFound">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="Generic.PHP.NoSilencedErrors">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>

	<!-- ==========================================================
	     Project-specific configuration.
	     ========================================================== -->

	<!-- Global prefixes for functions, classes and constants. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="My_Project" />
				<element value="my_project" />
				<element value="MY_PROJECT" />
			</property>
		</properties>
	</rule>

	<!-- Text domain(s) used by this project. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="my-project" />
			</property>
		</properties>
	</rule>

</ruleset>
