{
	"slug": "eslint",
	"category": "lint",
	"name": "ESLint setup",
	"description": "Installs ESLint with rtCamp's shared config (extends `@rtcamp/wp-tooling/eslint-config`) and adds lint:js scripts.",
	"source": "template",
	"files": [
		{
			"src": "templates/.eslintrc.js.mustache",
			"dest": ".eslintrc.js"
		}
	],
	"npm_dev_dependencies": {
		"eslint": "8.57.1",
		"@wordpress/eslint-plugin": "^22.0.0",
		"@rtcamp/wp-tooling": "^1.0.0"
	},
	"scripts": {
		"npm": {
			"lint:js": "eslint 'src/**/*.js' 'assets/**/*.js'",
			"lint:js:fix": "eslint 'src/**/*.js' 'assets/**/*.js' --fix"
		}
	}
}
