{
	"slug": "full",
	"category": "lint/phpcs",
	"name": "PHPCS - rtCamp full",
	"description": "PHP_CodeSniffer with rtCamp's shared standard: WordPress-Core, Extra, Docs, and VIP-Go rules via wp-php-toolkit.",
	"source": "template",
	"files": [
		{
			"src": "templates/phpcs.xml.dist.mustache",
			"dest": "phpcs.xml.dist"
		}
	],
	"composer_dev_dependencies": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"rtcamp/wp-php-toolkit": "^1.0"
	},
	"scripts": {
		"composer": {
			"lint:php": "phpcs --standard=phpcs.xml.dist",
			"lint:php:fix": "phpcbf --standard=phpcs.xml.dist"
		}
	}
}
