<?xml version="1.0"?>
<ruleset name="Project">
	<description>Extends rtCamp shared standard: WordPress-Core, Extra, Docs, and VIP-Go rules.</description>

	<!--
		Scaffolded by @rtcamp/wp-tooling. The shared rules live at
		vendor/rtcamp/wp-framework/phpcs.xml.dist. Override a rule for
		this project by adding it below the include line.
	-->

	<rule ref="vendor/rtcamp/wp-framework/phpcs.xml.dist"/>

	<file>./</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<!-- Project-specific overrides go here. -->

	<!--
		Allow unused function parameters. WordPress hook/filter callbacks,
		interface methods, and REST/CLI handlers routinely carry
		signature-mandated parameters they do not use. Unused local variables
		are still reported.
	-->
	<rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis">
		<properties>
			<property name="allowUnusedFunctionParameters" value="true"/>
		</properties>
	</rule>
</ruleset>
