{
	"slug": "vip",
	"category": "lint/phpcs",
	"name": "PHPCS - WordPress VIP Minimum",
	"description": "PHP_CodeSniffer with WordPress VIP Minimum standard for VIP Go platform projects.",
	"source": "template",
	"files": [
		{
			"src": "templates/phpcs.xml.dist.mustache",
			"dest": "phpcs.xml.dist"
		}
	],
	"composer_dev_dependencies": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"automattic/vip-coding-standards": "^3.0"
	},
	"scripts": {
		"composer": {
			"lint:php": "phpcs --standard=phpcs.xml.dist",
			"lint:php:fix": "phpcbf --standard=phpcs.xml.dist"
		}
	}
}
