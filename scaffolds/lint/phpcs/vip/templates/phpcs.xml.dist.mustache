<?xml version="1.0"?>
<ruleset name="Project">
	<description>WordPress VIP Minimum standard for VIP Go platform deployments.</description>

	<!--
		Scaffolded by @rtcamp/wp-tooling. WordPress-VIP-Minimum includes WordPress-Core
		rules. WordPress-Docs is added separately for docblock coverage.

		Requires automattic/vip-coding-standards in your composer.json dev dependencies.
	-->

	<rule ref="WordPress-VIP-Minimum"/>
	<rule ref="WordPress-Docs"/>

	<file>./</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<!-- Project-specific overrides go here. -->
</ruleset>
