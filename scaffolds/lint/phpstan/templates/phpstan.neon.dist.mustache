# PHPStan config: extends rtCamp/wp-framework shared baseline.
#
# Scaffolded by @rtcamp/wp-tooling. The shared baseline lives at
# vendor/rtcamp/wp-framework/phpstan.neon.dist. Override a rule for
# this project by adding it under `parameters` below.

includes:
    - vendor/rtcamp/wp-framework/phpstan.neon.dist

parameters:
    level: 5
    paths:
        - src
        - includes
    excludePaths:
        - vendor
        - node_modules
        - build
        - tests
    # Project-specific overrides go here.
